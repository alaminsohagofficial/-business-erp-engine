# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Use MongoDB Atlas URL in Production)
MONGO_URI=mongodb://localhost:27017/business_erp_engine

# Security & Authentication (Add your production secrets)
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# SAP / External API Gateway Credentials (Optional)
SAP_API_GATEWAY_URL=https://api.sap.example.com
